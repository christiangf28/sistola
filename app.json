{
  "expo": {
    "name": "Sistola",
    "slug": "sistola",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sistola",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sistola.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sistola usa la cámara para establecer tu foto de perfil.",
        "NSPhotoLibraryUsageDescription": "Sistola accede a tus fotos para tu foto de perfil.",
        "NSPhotoLibraryAddUsageDescription": "Sistola guarda imágenes al compartir tus registros de presión."
      }
    },
    "android": {
      "package": "com.sistola.app",
      "adaptiveIcon": {
        "backgroundColor": "#7F77DD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#7F77DD",
          "dark": {
            "backgroundColor": "#0E0D1A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sistola accede a tus fotos para tu foto de perfil.",
          "cameraPermission": "Sistola usa la cámara para tu foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7F77DD",
          "sounds": []
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a1cf187-93fd-473c-b501-d3450a46aa1f"
      }
    },
    "owner": "rodomonkey"
  }
}
